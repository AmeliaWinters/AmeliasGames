# Loaded only by `vite build --mode android` (see the "apk" script).
#
# The Android build serves its UI from inside the APK, so there is no server on
# its own origin — it needs the absolute address of the deployed worker. The
# web build deliberately does NOT load this file, so it keeps talking to
# whatever origin served it.
VITE_SERVER_ORIGIN=https://amelias-games.anonylunt.workers.dev
