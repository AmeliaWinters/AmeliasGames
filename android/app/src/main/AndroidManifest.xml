<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Deliberately no VIEW filter for the invite host.
                 Claiming the host only pays off with two things this app does
                 not yet have: a listener for Capacitor's appUrlOpen to read the
                 room code out of the fragment (Android does not match on it, so
                 the code never arrives as an intent path), and an
                 /.well-known/assetlinks.json served from the host and signed
                 with the release certificate, without which autoVerify fails
                 and Android 12+ ignores the filter anyway.
                 With neither in place, claiming the host was strictly worse
                 than not claiming it: the tap left the browser -- where the
                 link works -- and opened the app at its start page with the
                 room code discarded, dropping the friend into an empty lobby.
                 Restore this filter alongside @capacitor/app and assetlinks,
                 not before. -->

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
