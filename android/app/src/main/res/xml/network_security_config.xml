<?xml version="1.0" encoding="utf-8"?>
<!--
  Release posture: no cleartext, anywhere. The app talks to one https origin.
  The debug build overrides this (see src/debug/res/xml) so LAN testing against
  a plain-http dev server still works, and that allowance cannot escape into a
  release APK.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
