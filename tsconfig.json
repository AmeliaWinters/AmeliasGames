{
  // What editors pick up: the union, so every file resolves. The real boundary
  // is enforced by `npm run typecheck`, which compiles each surface separately
  // against only the globals it has.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"]
  },
  "include": ["src"]
}
